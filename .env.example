# ==============================================================================
# BEACON / TRACK YOUR FRIENDS — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# NEVER commit real secrets, private keys, or database passwords to source code.
# Format for each variable below:
#   - VARIABLE
#   - PURPOSE
#   - WHERE TO GET IT
#   - WHERE TO CONFIGURE IT
#   - CLIENT OR SERVER
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION BACKEND & WEBSOCKET (CLIENT & SERVER)
# ------------------------------------------------------------------------------
# VARIABLE: VITE_API_BASE_URL
# PURPOSE: Centralized HTTPS production backend URL used by both Website and Android APK.
# WHERE TO GET IT: Google Cloud Run / AI Studio deployed service URL.
# WHERE TO CONFIGURE IT: .env / .env.production (bundled at build time via Vite).
# CLIENT OR SERVER: CLIENT (Public endpoint URL)
VITE_API_BASE_URL=YOUR_PRODUCTION_API_URL

# VARIABLE: VITE_WS_URL
# PURPOSE: Centralized WSS production WebSocket endpoint for real-time location, chat, and presence.
# WHERE TO GET IT: Derived from Cloud Run service URL using wss:// protocol + /ws path.
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT (Public WSS endpoint URL)
VITE_WS_URL=YOUR_PRODUCTION_WSS_URL

# VARIABLE: APP_URL
# PURPOSE: Canonical server origin for sitemap, robots.txt, and self-referential links.
# WHERE TO GET IT: Injected automatically by Cloud Run / AI Studio runtime.
# WHERE TO CONFIGURE IT: Server environment variables.
# CLIENT OR SERVER: SERVER
APP_URL=YOUR_PRODUCTION_API_URL

# ------------------------------------------------------------------------------
# 2. FIREBASE / CLOUD FIRESTORE CONFIGURATION (CLIENT PUBLIC IDENTIFIERS)
# ------------------------------------------------------------------------------
# VARIABLE: VITE_FIREBASE_API_KEY
# PURPOSE: Public Firebase Web/REST API key for authenticating requests to the project's Firestore database.
# WHERE TO GET IT: Firebase Console -> Project Settings -> General -> Your Apps (or firebase-applet-config.json).
# WHERE TO CONFIGURE IT: .env / .env.production and firebase-applet-config.json
# CLIENT OR SERVER: CLIENT (Public identifier; restrict in GCP Console -> APIs & Services -> Credentials)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# VARIABLE: VITE_FIREBASE_AUTH_DOMAIN
# PURPOSE: Firebase Authentication domain for OAuth / session flows.
# WHERE TO GET IT: Firebase Console -> Project Settings -> General
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN

# VARIABLE: VITE_FIREBASE_PROJECT_ID
# PURPOSE: Google Cloud / Firebase Project ID hosting the shared production Firestore database.
# WHERE TO GET IT: Firebase Console -> Project Settings -> General
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# VARIABLE: VITE_FIREBASE_DATABASE_ID
# PURPOSE: Specific Cloud Firestore database instance ID shared by Web, Server, and Android APK.
# WHERE TO GET IT: Firebase Console -> Firestore Database (or firebase-applet-config.json)
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT
VITE_FIREBASE_DATABASE_ID=YOUR_FIREBASE_DATABASE_ID

# VARIABLE: VITE_FIREBASE_STORAGE_BUCKET
# PURPOSE: Firebase Cloud Storage bucket identifier.
# WHERE TO GET IT: Firebase Console -> Project Settings -> General
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET

# VARIABLE: VITE_FIREBASE_MESSAGING_SENDER_ID
# PURPOSE: Firebase Cloud Messaging (FCM) sender ID for push notifications.
# WHERE TO GET IT: Firebase Console -> Project Settings -> Cloud Messaging
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID

# VARIABLE: VITE_FIREBASE_APP_ID
# PURPOSE: Firebase Application ID.
# WHERE TO GET IT: Firebase Console -> Project Settings -> General
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# VARIABLE: VITE_FIREBASE_VAPID_KEY
# PURPOSE: Optional Web Push (FCM) public VAPID key for browser push notifications.
# WHERE TO GET IT: Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
# WHERE TO CONFIGURE IT: .env / .env.production
# CLIENT OR SERVER: CLIENT (Optional — native Web Notifications API + WebSocket/Firestore push work without it)
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_KEY

# ------------------------------------------------------------------------------
# 3. MAPS & GEOLOCATION (OPTIONAL CLIENT PUBLIC KEY)
# ------------------------------------------------------------------------------
# VARIABLE: VITE_GOOGLE_MAPS_API_KEY
# PURPOSE: Optional Google Maps Platform API key for Google Places / geocoding enhancement (default map uses Leaflet + CARTO/OSM/Esri tiles with zero key required).
# WHERE TO GET IT: Google Cloud Console -> Google Maps Platform -> Credentials
# WHERE TO CONFIGURE IT: .env / .env.production (Restrict by HTTP referrer for Web and package name `com.beacon.mesh` + SHA-256 for Android).
# CLIENT OR SERVER: CLIENT (Optional)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ------------------------------------------------------------------------------
# 4. SERVER-ONLY SECRETS (NEVER EXPOSE IN FRONTEND OR ANDROID APK)
# ------------------------------------------------------------------------------
# VARIABLE: GEMINI_API_KEY
# PURPOSE: Server-side API key if server-side AI routes are invoked.
# WHERE TO GET IT: Google AI Studio Secrets panel.
# WHERE TO CONFIGURE IT: Server runtime environment only (never prefix with VITE_).
# CLIENT OR SERVER: SERVER ONLY
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_API_KEY
