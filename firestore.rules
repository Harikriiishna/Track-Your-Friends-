rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "reddytest39@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isValidSyncDocId(docId) {
      return docId is string && docId == 'global_state';
    }

    function hasValidSyncPayload(data) {
      return (
        ('stateJson' in data &&
          data.stateJson is string &&
          data.stateJson.size() >= 2 &&
          data.stateJson.size() < 950000) ||
        ('payload' in data &&
          data.payload is string &&
          data.payload.size() >= 2 &&
          data.payload.size() < 950000)
      );
    }

    function isValidBeaconSyncDoc(data) {
      return data.keys().hasAll(['updatedAt']) &&
             data.keys().hasOnly(['stateJson', 'payload', 'updatedAt']) &&
             hasValidSyncPayload(data) &&
             data.updatedAt is string &&
             data.updatedAt.size() >= 10 &&
             data.updatedAt.size() <= 64;
    }

    // ===============================================================
    // Beacon Synchronization State Collection (Validated Sync Bridge)
    // ===============================================================
    match /beacon_sync/{docId} {
      allow get: if isValidSyncDocId(docId);
      allow create, update: if isValidSyncDocId(docId) && isValidBeaconSyncDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
